<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="TutzApp.Views.GamepadShortcutOverlayWindow"
        mc:Ignorable="d"
        Title="TutzApp - Atalhos de Gamepad"
        Height="700"
        Width="1160"
        MinHeight="460"
        MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        Foreground="#FFF7F7F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="GamepadKeycapStyle" TargetType="Border">
      <Setter Property="Background" Value="#FF24213F"/>
      <Setter Property="BorderBrush" Value="#FF574FA0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="22"
          Background="#FF0E1017"
          BorderBrush="#FF3D3C50"
          BorderThickness="1"
          Padding="16">
    <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
      <Grid Width="1100" Height="625">
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Width="48" Height="48" CornerRadius="14"
                  Background="#FF272349" BorderBrush="#FF5E55B5" BorderThickness="1"
                  Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock Text="🎮" FontSize="21"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="PROJETO TUTZ" FontSize="9" FontWeight="Bold"
                       Foreground="#FF858394"/>
            <TextBlock Text="Atalhos de gamepad" FontSize="22" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" Margin="0,1,0,0"/>
            <TextBlock Text="Segure START / OPTIONS por 3 segundos para abrir ou ocultar."
                       FontSize="11" Foreground="#FFA7A4B4" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#FF171821" BorderBrush="#FF30303C"
                    BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,8,0">
              <TextBlock Text="{Binding Count, StringFormat={}{0} comandos}"
                         Foreground="#FFBDBAC7" FontSize="10"/>
            </Border>
            <Border Background="#FF171821" BorderBrush="#FF343442"
                    BorderThickness="1" CornerRadius="9" Padding="11,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="B" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           FontWeight="Bold" Foreground="#FFB8B0FF" Margin="0,0,7,0"/>
                <TextBlock Text="fecha" FontSize="10.5" Foreground="#FFB5B2C0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="5,0,5,5">
          <TextBlock Text="ATALHOS CONFIGURADOS" FontSize="10" FontWeight="SemiBold"
                     Foreground="#FFAAA1FF" VerticalAlignment="Center"/>
        </Grid>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Shortcuts}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#FF151720"
                      BorderBrush="#FF2C2D3A"
                      BorderThickness="1"
                      CornerRadius="11"
                      Padding="11,9"
                      Margin="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               Foreground="#FFF5F4FA"
                               FontWeight="SemiBold"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Style="{StaticResource GamepadKeycapStyle}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding ComboText}"
                                 Foreground="#FFF1EFFF"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 FontFamily="Cascadia Mono, Consolas"
                                 TextWrapping="Wrap"
                                 TextTrimming="None"/>
                    </Border>
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Text="{Binding DisplayDescription}"
                             Foreground="#FFE1DFE9"
                             FontSize="10.5"
                             LineHeight="14"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             TextAlignment="Left"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Top"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="5,3,5,0">
          <Border Height="1" Background="#FF292A35" VerticalAlignment="Top"/>
          <TextBlock Text="B no controle ou Esc no teclado para fechar"
                     Foreground="#FF85828F"
                     FontSize="10.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"/>
        </Grid>
      </Grid>
    </Viewbox>
  </Border>
</Window>
