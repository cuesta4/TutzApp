<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="TutzApp.Views.KeyboardShortcutOverlayWindow"
        mc:Ignorable="d"
        Title="TutzApp - Atalhos de Teclado"
        Height="720"
        Width="1180"
        MinHeight="480"
        MinWidth="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        Foreground="#FFF7F7F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="KeyboardKeycapStyle" TargetType="Border">
      <Setter Property="Background" Value="#FF172A3A"/>
      <Setter Property="BorderBrush" Value="#FF2D5C78"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="KeyboardKeyTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFEAF8FF"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="None"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="22"
          Background="#FF0D1117"
          BorderBrush="#FF39434E"
          BorderThickness="1"
          Padding="16">
    <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
      <Grid Width="1120" Height="650">
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Width="48" Height="48" CornerRadius="14"
                  Background="#FF132D3F" BorderBrush="#FF2D6D91" BorderThickness="1"
                  Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock Text="⌨" FontSize="22" Foreground="#FF8DDBFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="PROJETO TUTZ" FontSize="9" FontWeight="Bold"
                       Foreground="#FF7F8B98"/>
            <TextBlock Text="Atalhos de teclado" FontSize="22" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" Margin="0,1,0,0"/>
            <TextBlock Text="Todos os comandos globais em uma única tela."
                       FontSize="11" Foreground="#FF9AA7B4" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#FF151B22" BorderBrush="#FF29323B"
                    BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,8,0">
              <TextBlock Text="{Binding Count, StringFormat={}{0} comandos}"
                         Foreground="#FFB7C1CB" FontSize="10"/>
            </Border>
            <Border Background="#FF151B22" BorderBrush="#FF303A45"
                    BorderThickness="1" CornerRadius="9" Padding="11,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="F1" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           FontWeight="Bold" Foreground="#FF8DDBFF" Margin="0,0,7,0"/>
                <TextBlock Text="fecha" FontSize="10.5" Foreground="#FFB0BAC5"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="5,0,5,5">
          <TextBlock Text="ATALHOS DISPONÍVEIS" FontSize="10" FontWeight="SemiBold"
                     Foreground="#FF79C9F2" VerticalAlignment="Center"/>
        </Grid>

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" Rows="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#FF121820"
                      BorderBrush="#FF27313B"
                      BorderThickness="1"
                      CornerRadius="11"
                      Padding="10,8"
                      Margin="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="{Binding Category}"
                             Foreground="#FF79C9F2"
                             FontSize="8.5"
                             FontWeight="SemiBold"
                             Margin="1,0,0,4"/>

                  <Border Grid.Row="1" Style="{StaticResource KeyboardKeycapStyle}">
                    <TextBlock Text="{Binding Keys}"
                               Style="{StaticResource KeyboardKeyTextStyle}"/>
                  </Border>

                  <TextBlock Grid.Row="2"
                             Text="{Binding Description}"
                             Foreground="#FFE1E7ED"
                             FontSize="10.5"
                             LineHeight="14"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             TextAlignment="Left"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Top"
                             Margin="1,6,1,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="5,3,5,0">
          <Border Height="1" Background="#FF242D36" VerticalAlignment="Top"/>
          <TextBlock Text="F1 ou Esc para fechar"
                     Foreground="#FF7F8A95"
                     FontSize="10.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"/>
        </Grid>
      </Grid>
    </Viewbox>
  </Border>
</Window>
