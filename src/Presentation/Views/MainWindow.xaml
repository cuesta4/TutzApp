                  </StackPanel>
                </ui:Card>
                <TextBlock Text="Ajuda rápida" Style="{StaticResource SectionTitleTextStyle}" Margin="0,4,0,12"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
