                          <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource SystemAccentColorBrush}" FontSize="18" Margin="0,0,8,0"/>
                          <TextBlock Text="Informações Gerais" VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}"/>
                        </StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nome do Atalho:" Style="{StaticResource FieldLabelTextStyle}"/>
                            <ui:TextBox Text="{Binding NewShortcutName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex: Abrir Steam, Capturar Tela..." Height="34" VerticalContentAlignment="Center" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                          </StackPanel>
