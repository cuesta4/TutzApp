<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:TutzApp.ViewModels" x:Class="TutzApp.Views.MainWindow" Title="Projeto Tutz - Dashboard" Icon="pack://application:,,,/Assets/AppIcon.ico" Height="700" Width="1020" MinHeight="640" MinWidth="960" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextOptions.TextRenderingMode="ClearType">
  <ui:FluentWindow.Resources>
