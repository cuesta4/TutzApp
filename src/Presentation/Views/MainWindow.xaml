      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style x:Key="UnifiedEntryListItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="UnifiedShortcutKeyBorderStyle" TargetType="Border" BasedOn="{StaticResource UnifiedEntryTagBorderStyle}">
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,4,0,12"/>
    </Style>
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="HiddenTabItemStyle" TargetType="TabItem">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Root" Margin="0,2" Padding="12,9" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BorderlessTabControlStyle" TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"/>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DrawerNavButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="6,3"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DrawerNavRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="6,3"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Border Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </Border>
                <Border x:Name="ActiveIndicator" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource SystemAccentColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/>
                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlAltFillColorQuaternaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Modern extended TitleBar -->
    <ui:TitleBar Grid.Row="0" Title="Projeto Tutz - Dashboard" Icon="pack://application:,,,/Assets/AppIcon.ico" Height="48"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="280"/>
        <!-- Status do sistema -->
        <ColumnDefinition Width="*"/>
        <!-- Área central -->
      </Grid.ColumnDefinitions>
      <Border x:Name="DrawerPanel" Grid.Column="0" Width="64" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="Transparent" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Style="{StaticResource DrawerNavButtonStyle}" Click="ToggleDrawer_Click" Margin="8,10,8,8" ToolTip="Recolher menu">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Navigation24" Width="18" Margin="0"/>
              <TextBlock x:Name="DrawerTitleText" Tag="DrawerLabel" Text="Projeto Tutz" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" IsChecked="True" Click="NavGeneral_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Home24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Geral" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavMonitor_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Desktop24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Monitor" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavGamepad_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="XboxController24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Gamepad" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavKeyboard_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Keyboard24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Teclado" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavMouse_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Cursor24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Mouse" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
            <Separator Margin="12,9,12,7" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <RadioButton Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavAutomation_Click" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" Width="18" Margin="0"/>
                <TextBlock Tag="DrawerLabel" Text="Automação" Visibility="Collapsed" Opacity="0"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <RadioButton Grid.Row="2" Style="{StaticResource DrawerNavRadioButtonStyle}" GroupName="DrawerNav" Click="NavLogs_Click" Margin="8,8,8,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Clipboard24" Width="18" Margin="0"/>
              <TextBlock Tag="DrawerLabel" Text="Logs" Visibility="Collapsed" Opacity="0"/>
            </StackPanel>
          </RadioButton>
        </Grid>
      </Border>
      <!-- PAINEL LATERAL: STATUS GERAL -->
      <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="Transparent" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="STATUS DO SISTEMA" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14"/>
          <!-- CARD DE STATUS DE RESOLUÇÃO -->
          <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Resolução Ativa" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding CurrentResolution}" Margin="0,2,0,0" Style="{StaticResource StatusValueTextStyle}"/>
              </StackPanel>
            </Grid>
          </ui:Card>
          <!-- CARD DE STATUS DE JOGO -->
          <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="Games24" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Jogo Ativo" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding ActiveGame}" Margin="0,2,0,0" Style="{StaticResource StatusValueTextStyle}"/>
              </StackPanel>
            </Grid>
          </ui:Card>
          <!-- CARD VELOCIDADE MOUSE -->
          <ui:Card Grid.Row="3" Margin="0,0,0,12" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="Cursor24" FontSize="22" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Velocidade Mouse" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="{Binding MouseSpeed}" Style="{StaticResource StatusValueTextStyle}"/>
                  <TextBlock Text="/20" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ui:Card>
          <!-- CARD DE STATUS DE CONEXÃO DO GAMEPAD -->
          <ui:Card Grid.Row="4" VerticalAlignment="Top" Margin="0,0,0,12" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="XboxController24" FontSize="22" Margin="0,0,12,0">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsGamepadConnected}" Value="True">
                        <Setter Property="Foreground" Value="#22C55E"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsGamepadConnected}" Value="False">
                        <Setter Property="Foreground" Value="#EF4444"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Controle Xbox" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding GamepadState}" Margin="0,2,0,0" Style="{StaticResource StatusValueTextStyle}"/>
              </StackPanel>
            </Grid>
          </ui:Card>
          <!-- WATCHDOG STATUS -->
          <ui:Card Grid.Row="5" Padding="12">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#22C55E" FontSize="16" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium"/>
            </StackPanel>
          </ui:Card>
        </Grid>
      </Border>
      <!-- ÁREA CENTRAL COM ABAS -->
      <Border Grid.Column="2" Margin="16" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <TabControl x:Name="MainTabs" Style="{StaticResource BorderlessTabControlStyle}" ItemContainerStyle="{StaticResource HiddenTabItemStyle}" Background="Transparent" BorderThickness="0" Padding="4">
          <!-- ABAS PRINCIPAIS -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Home24" Margin="0,0,6,0" FontSize="16"/>
                <TextBlock Text="Geral" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,22,20,20" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
              <StackPanel>
                <TextBlock Text="Configurações Gerais" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Preferências globais do TutzApp, inicialização, segurança e acesso rápido à ajuda." Style="{StaticResource PageDescriptionTextStyle}"/>
                <TextBlock Text="Inicialização" Style="{StaticResource SectionTitleTextStyle}"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" Margin="0,0,14,0">
                      <ui:SymbolIcon Symbol="Power24" Foreground="{DynamicResource SystemAccentColorBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Iniciar serviço em segundo plano com o Windows" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Registra o TutzApp na inicialização usando --background, mantendo o ícone na bandeja sem abrir o painel." Margin="0,3,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsAutoStartEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <TextBlock Text="Segurança" Style="{StaticResource SectionTitleTextStyle}" Margin="0,4,0,12"/>
