                      <TextBlock Text="{Binding TerminalContextMenuStatus, StringFormat=Status: {0}}" Style="{StaticResource CardCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <ui:Button Content="Verificar" Command="{Binding RefreshTerminalContextMenuStatusCommand}" Height="36" Padding="16,0" FontWeight="Medium" Margin="0,0,8,0" ToolTip="Verifica se o pacote moderno e os dois comandos clássicos estão registrados."/>
                        <ui:Button Content="Instalar / reparar" Command="{Binding InstallTerminalContextMenuCommand}" Height="36" Padding="16,0" FontWeight="Medium" Appearance="Primary" Margin="0,0,8,0" ToolTip="Instala ou repara as integrações com os menus moderno e clássico do Windows 11."/>
                        <ui:Button Content="Desinstalar" Command="{Binding UninstallTerminalContextMenuCommand}" Height="36" Padding="16,0" FontWeight="Medium" ToolTip="Remove o pacote moderno, os dois comandos clássicos, a confiança local do certificado e resíduos de versões anteriores."/>
                      </WrapPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="56,16,0,0">
                      <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,14"/>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Atalhos do TutzApp" Style="{StaticResource CardTitleTextStyle}"/>
                          <TextBlock Text="Remova ou restaure individualmente as opções Normal e Elevado dentro de “Abrir no Terminal”." Style="{StaticResource CardDescriptionTextStyle}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                          <ui:Button Content="Atualizar" Command="{Binding RefreshTerminalContextMenuCommandsCommand}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                          <ui:Button Content="Restaurar todos" Command="{Binding RestoreTerminalContextMenuCommandsCommand}" Height="34" Padding="14,0"/>
                        </WrapPanel>
                      </Grid>
                      <ListView ItemsSource="{Binding TerminalContextMenuCommands}" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource UnifiedEntryBorderStyle}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                                  <TextBlock Text="{Binding Description}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource UnifiedEntryTagBorderStyle}" Margin="16,0,12,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource UnifiedStatusTagTextStyle}"/>
                                </Border>
                                <ui:Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding DataContext.ToggleTerminalContextMenuCommandCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Height="34" MinWidth="88" Padding="14,0" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>

                      <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,14"/>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Atalhos de outros aplicativos" Style="{StaticResource CardTitleTextStyle}"/>
                          <TextBlock Text="Procura menus do Windows Terminal, TeraCopy e outros apps no menu moderno e em “Mostrar mais opções”: ProgIDs, extensões, SystemFileAssociations, Applications, submenus clássicos, handlers COM e pacotes MSIX. A remoção é reversível e não desinstala o aplicativo." Style="{StaticResource CardDescriptionTextStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                          <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding IsExplorerContextMenuScanRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,0"/>
                          <ui:Button Content="Procurar atalhos" Command="{Binding RefreshExplorerContextMenuEntriesCommand}" Height="34" Padding="14,0"/>
                        </StackPanel>
                      </Grid>
                      <Border Padding="11,8" Margin="0,0,0,10" CornerRadius="7" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding ExplorerContextMenuScanStatus}" Style="{StaticResource CardCaptionTextStyle}"/>
                      </Border>
                      <Grid Margin="0,0,0,10">
                        <ui:TextBox Text="{Binding ExplorerContextMenuSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filtrar por aplicativo, comando, origem ou status..." Padding="36,6,10,6" MinHeight="36"/>
                        <ui:SymbolIcon Symbol="Search24" Width="16" Height="16" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                      </Grid>
                      <ListView ItemsSource="{Binding ExplorerContextMenuEntriesView}" MaxHeight="356" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource UnifiedEntryBorderStyle}" ToolTip="{Binding Description}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding ApplicationName}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}"/>
                                  <WrapPanel Margin="0,7,0,0">
                                    <Border Style="{StaticResource UnifiedEntryTagBorderStyle}" Margin="0,0,6,0">
                                      <TextBlock Text="{Binding SourceText}" Style="{StaticResource UnifiedEntryTagTextStyle}" MaxWidth="360"/>
                                    </Border>
                                    <Border Style="{StaticResource UnifiedEntryTagBorderStyle}">
                                      <TextBlock Text="{Binding ElevationText}" Style="{StaticResource UnifiedEntryTagTextStyle}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>
                                  </WrapPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource UnifiedEntryTagBorderStyle}" Margin="16,0,12,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding StatusText}" Style="{StaticResource UnifiedStatusTagTextStyle}" MaxWidth="120"/>
                                </Border>
                                <ui:Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding DataContext.ToggleExplorerContextMenuEntryCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" IsEnabled="{Binding CanToggle}" Height="34" MinWidth="88" Padding="14,0" VerticalAlignment="Center" ToolTip="Desativa/restaura somente a entrada do menu; o aplicativo permanece instalado."/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </StackPanel>
                  </Grid>
                </ui:Card>
                <TextBlock Text="Jogos monitorados" Style="{StaticResource SectionTitleTextStyle}" Margin="0,4,0,12"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Insira a lista de executáveis de jogos monitorados (separados por vírgula):" Style="{StaticResource FieldLabelTextStyle}"/>
                    <ui:TextBox Text="{Binding MonitoredGamesText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                  </StackPanel>
                </ui:Card>
                <TextBlock Text="Regras automáticas" Style="{StaticResource SectionTitleTextStyle}" Margin="0,4,0,12"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <!-- Regra 1 -->
                    <Grid Margin="0,0,0,15">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Troca Automática de Resolução (CS2)" Style="{StaticResource CardTitleTextStyle}"/>
                        <TextBlock Text="Muda para 1920x1080@144Hz ao abrir o CS2 e restaura a resolução anterior ao sair." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoResolutionSwitch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,15"/>
                    <!-- Regra 2 -->
                    <Grid Margin="0,0,0,15">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Troca Automática de Perfil de Hardware (Teclado/Mouse)" Style="{StaticResource CardTitleTextStyle}"/>
                        <TextBlock Text="Troca as configurações do mouse e o perfil do teclado automaticamente ao detectar jogos abertos." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGameProfileSwitch}" x:Name="AutoProfileSwitch" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Sub-painel de configurações dos perfis de automação -->
                    <StackPanel Margin="0,0,0,15" Visibility="{Binding ElementName=AutoProfileSwitch, Path=IsChecked, Converter={StaticResource BoolToVisibility}}">
                      <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Perfil de Jogo -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                          <StackPanel>
                            <TextBlock Text="Perfil de Jogo (Ativo durante o jogo)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                            <TextBlock Text="DPI do Mouse" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableDpiOptions}" SelectedItem="{Binding AutoGameDpi}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Polling Rate" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailablePollingOptions}" SelectedItem="{Binding AutoGamePolling}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding StringFormat={}{0} Hz}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Velocidade no Windows" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableSpeedOptions}" SelectedItem="{Binding AutoGameSpeed}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding StringFormat={}{0} / 20}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Brilho do Teclado" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableBrightnessOptions}" SelectedItem="{Binding AutoGameKeyboardBrightness}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Perfil do Teclado" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableKeyboardProfiles}" SelectedItem="{Binding AutoGameKeyboardProfile}" HorizontalAlignment="Stretch" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <!-- Perfil Normal -->
                        <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                          <StackPanel>
                            <TextBlock Text="Perfil Normal (Fora dos jogos)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="DPI do Mouse" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableDpiOptions}" SelectedItem="{Binding AutoNormalDpi}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Polling Rate" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailablePollingOptions}" SelectedItem="{Binding AutoNormalPolling}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding StringFormat={}{0} Hz}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Velocidade no Windows" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableSpeedOptions}" SelectedItem="{Binding AutoNormalSpeed}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding StringFormat={}{0} / 20}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Brilho do Teclado" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableBrightnessOptions}" SelectedItem="{Binding AutoNormalKeyboardBrightness}" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Perfil do Teclado" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailableKeyboardProfiles}" SelectedItem="{Binding AutoNormalKeyboardProfile}" HorizontalAlignment="Stretch" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalContentAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </ui:Card>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Clipboard24" Margin="0,0,6,0" FontSize="16"/>
                <TextBlock Text="Logs" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="14,18,14,14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Logs de Diagnóstico" Style="{StaticResource PageTitleTextStyle}"/>
              <TextBlock Grid.Row="1" Text="Acompanhe eventos internos, ações de atalhos, dispositivos e automações em tempo real." Style="{StaticResource PageDescriptionTextStyle}"/>
              <!-- Histórico de logs -->
              <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registro de Log de Eventos:" Style="{StaticResource FieldLabelTextStyle}"/>
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                  <ListView ItemsSource="{Binding Logs}" FontSize="11" FontFamily="Consolas" BorderThickness="0" Background="Transparent" Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="Focusable" Value="False"/>
                      </Style>
                    </ListView.ItemContainerStyle>
                  </ListView>
                </Border>
              </Grid>
              <ui:Button Grid.Row="3" Content="Limpar Histórico de Logs" Command="{Binding ClearLogsCommand}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,15,0,0" Height="36" Padding="16,0" FontWeight="Medium"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
