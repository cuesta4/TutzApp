              </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,22,20,20" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
              <StackPanel>
                <TextBlock Text="Monitor e Cor" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Controle Digital Vibrance por aplicativo usando a janela em foco e restaure o padrão automaticamente ao sair." Style="{StaticResource PageDescriptionTextStyle}"/>
                <TextBlock Text="Digital Vibrance por Aplicativo" Style="{StaticResource SectionTitleTextStyle}"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Ajuste automático via NVIDIA NVAPI" Style="{StaticResource CardTitleTextStyle}"/>
                        <TextBlock Text="Checa a janela em foco a cada 2 segundos. O valor do app é somado ao padrão: 0% = 50% no driver, 100% = 100% no driver." Margin="0,3,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsVibranceEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Padrão do driver ao sair dos apps" Style="{StaticResource FieldLabelTextStyle}"/>
                        <TextBlock Text="Normalmente 50%. Use outro valor apenas se seu padrão no Painel NVIDIA for diferente." Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                      <ui:NumberBox Grid.Column="1" Value="{Binding VibranceDefaultDriverLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0,0,0" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                    <ListView ItemsSource="{Binding VibranceAppRules}" MaxHeight="292" Margin="0,0,0,14" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource UnifiedEntryBorderStyle}">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Image Grid.RowSpan="2" Grid.Column="0" Source="{Binding IconPath}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                              <StackPanel Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                                <TextBlock Text="{Binding ProcessName}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}"/>
                              </StackPanel>
                              <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,12,3" Text="Vibrance do app" Style="{StaticResource CompactFieldLabelTextStyle}"/>
                              <ui:NumberBox Grid.Row="1" Grid.Column="2" Margin="12,0" Value="{Binding AppVibrancePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                              <ui:Button Grid.Row="1" Grid.Column="3" Command="{Binding DataContext.RemoveVibranceAppCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" VerticalAlignment="Center" ToolTip="Remover aplicativo" Height="36" Padding="16,0" FontWeight="Medium">
                                <ui:SymbolIcon Symbol="Delete24"/>
                              </ui:Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <ui:Button Content="Adicionar .exe" Command="{Binding AddVibranceAppCommand}" Appearance="Secondary" HorizontalAlignment="Right" Padding="18,8" Height="36" FontWeight="Medium"/>
                  </StackPanel>
                </ui:Card>
                <TextBlock Text="NoMoreBorder" Style="{StaticResource SectionTitleTextStyle}"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Jogos em janela sem bordas" Style="{StaticResource CardTitleTextStyle}"/>
                        <TextBlock Text="Quando um app cadastrado é detectado, o helper administrativo remove as bordas e posiciona a janela no display configurado automaticamente." Margin="0,3,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                    </Grid>
                    <ListView ItemsSource="{Binding BorderlessApps}" MaxHeight="292" Margin="0,0,0,14" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource UnifiedEntryBorderStyle}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <Image Grid.Column="0" Source="{Binding IconPath}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                                <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}"/>
                              </StackPanel>
                              <ui:Button Grid.Column="2" Command="{Binding DataContext.EditBorderlessAppCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" VerticalAlignment="Center" ToolTip="Opções de display, posição e resolução" Height="36" Padding="16,0" FontWeight="Medium" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="Settings24"/>
                              </ui:Button>
                              <ui:Button Grid.Column="3" Command="{Binding DataContext.RemoveBorderlessAppCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" VerticalAlignment="Center" ToolTip="Remover aplicativo" Height="36" Padding="16,0" FontWeight="Medium">
                                <ui:SymbolIcon Symbol="Delete24"/>
                              </ui:Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                    <ui:Button Command="{Binding AddBorderlessAppCommand}" Appearance="Secondary" HorizontalAlignment="Right" Padding="18,8" Height="36" FontWeight="Medium">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Adicionar .exe" VerticalAlignment="Center"/>
                      </StackPanel>
                    </ui:Button>
                  </StackPanel>
                </ui:Card>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="XboxController24" Margin="0,0,6,0" FontSize="16"/>
                <TextBlock Text="Gamepad" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,22,20,20" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
              <StackPanel>
                <TextBlock Text="Integração de Gamepad" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Monitore as conexões físicas e controle atalhos de gravação de forma silenciosa diretamente no seu controle de Xbox." Style="{StaticResource PageDescriptionTextStyle}"/>
                <TextBlock Text="Dispositivo e calibração" Style="{StaticResource SectionTitleTextStyle}"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Controle Xbox Selecionado" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Status atual de detecção física via XInput e Windows Gaming Input." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGamepadConnected}" Value="True">
                              <Setter Property="Background" Value="#1022C55E"/>
                              <Setter Property="BorderBrush" Value="#4422C55E"/>
                              <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGamepadConnected}" Value="False">
                              <Setter Property="Background" Value="#10EF4444"/>
                              <Setter Property="BorderBrush" Value="#44EF4444"/>
                              <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding GamepadState}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValueTextStyle}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsGamepadConnected}" Value="True">
                                <Setter Property="Foreground" Value="#22C55E"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsGamepadConnected}" Value="False">
                                <Setter Property="Foreground" Value="#EF4444"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </Grid>
                </ui:Card>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Calibração HID" Style="{StaticResource CardTitleTextStyle}"/>
                        <TextBlock Text="Reconhece o layout HID do controle e salva VID/PID, relatório e offset dos botões." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                      </StackPanel>
                      <ui:Button Grid.Column="1" Content="Calibrar" Command="{Binding CalibrateGamepadCommand}" Appearance="Primary" VerticalAlignment="Center" Padding="18,8" Height="36" FontWeight="Medium"/>
                    </Grid>
                    <ListView ItemsSource="{Binding RecognizedGamepads}" MaxHeight="228" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource UnifiedEntryBorderStyle}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                                <TextBlock Text="{Binding DevicePath}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Border Grid.Column="1" Style="{StaticResource UnifiedEntryTagBorderStyle}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Layout}" Style="{StaticResource UnifiedEntryTagTextStyle}" FontFamily="Cascadia Mono, Consolas"/>
                              </Border>
                              <ui:Button Grid.Column="2"
                                         Content="Excluir"
                                         Command="{Binding DataContext.DeleteGamepadCalibrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         Appearance="Secondary"
                                         Margin="8,0,0,0"
                                         Padding="12,6"
                                         VerticalAlignment="Center"
                                         ToolTip="Exclui este mapeamento para permitir uma nova calibração."/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                  </StackPanel>
                </ui:Card>
                <TextBlock Text="Comportamento do controle" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,12"/>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Sensibilidade do Modo Mouse" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Ajusta a velocidade máxima linear do cursor. 100% = 800 counts/s no analógico totalmente inclinado." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:NumberBox Grid.Column="1" Value="{Binding GamepadMouseSensitivityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="10" Maximum="200" SmallChange="5" LargeChange="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0,0,0" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                  </Grid>
                </ui:Card>
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Intervalo de Double Press" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Tempo máximo entre dois cliques para disparar atalhos DoublePress. O valor é limitado automaticamente entre 120 e 1000 ms." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:NumberBox Grid.Column="1" Value="{Binding DoublePressIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="120" Maximum="1000" SmallChange="25" LargeChange="100" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0,0,0" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                  </Grid>
                </ui:Card>
                <!-- Modo Game Console & Integrações -->
                <TextBlock Text="Modo Game Console &amp; Sistema" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,12"/>
                <!-- Suprimir navegação nativa do Windows -->
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Suprimir navegação nativa do Windows (ControllerToVKMapping)" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Desativa a conversão automática do controle em setas/Enter/Esc no Windows Desktop via HKLM para evitar conflitos com jogos e emuladores." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SuppressWindowsControllerVkMapping, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <!-- Assumir botão Guia / Nexus -->
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Assumir botão Guia / Nexus (Tap: Game Bar | Hold: Task View)" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Captura o botão central. Pressionamento rápido abre a Xbox Game Bar (Win+G); retenção prolongada abre a visão de tarefas do Windows (Win+Tab)." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OwnGuideButton, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <!-- Limiar de Hold do Guia -->
                <ui:Card Padding="18" Margin="0,0,0,16" Visibility="{Binding OwnGuideButton, Converter={StaticResource BoolToVisibility}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Tempo de Hold do Botão Guia (ms)" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Tempo necessário mantendo o botão pressionado para disparar o Task View (Win+Tab). Padrão: 700 ms." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:NumberBox Grid.Column="1" Value="{Binding GuideHoldThresholdMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="200" Maximum="3000" SmallChange="50" LargeChange="100" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0,0,0" MinHeight="34" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                  </Grid>
                </ui:Card>
                <!-- Navegação por controle na Game Bar -->
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Navegação por controle na Xbox Game Bar" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Traduz D-Pad e analógico (com histerese e trava de eixo dominante) para setas, A para Enter e B para Esc enquanto a Game Bar estiver focada." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MapGamepadToKeyboardInGameBar, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <!-- Launch Focus Assist -->
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Assistente de Foco ao Iniciar Jogos (Launch Focus Assist)" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Rastreia processos filhos durante 12s após a inicialização e foca a janela real do jogo imediatamente uma única vez, desarmando o hook." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchFocusAssist, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <!-- Ponte IPC com Playnite -->
                <ui:Card Padding="18" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Ponte IPC com Playnite (Named Pipe Bridge)" Style="{StaticResource CardTitleTextStyle}"/>
                      <TextBlock Text="Comunicação em segundo plano via pipe com o plugin do Playnite para recepção antecipada de inicialização e delegação de foco." Margin="0,2,0,0" Style="{StaticResource CardDescriptionTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PlayniteBridgeEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  </Grid>
                </ui:Card>
                <!-- Atalhos Cadastrados (Full Width) -->
                <TextBlock Text="Atalhos do Gamepad" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,10"/>
                <ui:Card Padding="18,14,8,6" Margin="0,0,0,16">
                  <ListView ItemsSource="{Binding GamepadShortcuts}" MaxHeight="352" Style="{StaticResource UnifiedEntryListStyle}" ItemContainerStyle="{StaticResource UnifiedEntryListItemStyle}">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource UnifiedEntryBorderStyle}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" Style="{StaticResource UnifiedEntryTitleTextStyle}"/>
                              <TextBlock Text="{Binding DisplayDescription}" Style="{StaticResource UnifiedEntryDescriptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                              <WrapPanel Margin="0,7,0,0">
                                <Border Style="{StaticResource UnifiedEntryTagBorderStyle}" Margin="0,0,6,0">
                                  <TextBlock Text="{Binding ComboText}" Style="{StaticResource UnifiedEntryTagTextStyle}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                </Border>
                                <Border Style="{StaticResource UnifiedEntryTagBorderStyle}">
                                  <TextBlock Text="{Binding TriggerMode}" Style="{StaticResource UnifiedEntryTagTextStyle}" FontFamily="Cascadia Mono, Consolas"/>
                                </Border>
                              </WrapPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Command="{Binding DataContext.DeleteGamepadShortcutCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Remover atalho" Height="36" Padding="16,0" FontWeight="Medium">
                              <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </ui:Card>
                <!-- Criar Novo Atalho (Redesigned) -->
                <TextBlock Text="Criar Novo Atalho" Style="{StaticResource SectionTitleTextStyle}" Margin="0,18,0,10"/>
                <ui:Card Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <!-- Subseção 1: Identificação (Nome e Descrição) -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Background="{DynamicResource ControlAltFillColorQuaternaryBrush}" Margin="0,0,0,14">
